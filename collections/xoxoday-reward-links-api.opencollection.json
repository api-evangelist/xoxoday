{
  "opencollection": "1.0.0",
  "info": {
    "name": "Xoxoday Plum Rewards Authentication Reward Links API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://accounts.xoxoday.com/chef/v1/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Reward Links",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Generate Reward Links",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://accounts.xoxoday.com/chef/v1/oauth/api/generateLink",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Generate one or more personalized reward links for a campaign. Links can be distributed to recipients via email, SMS, or chat. Recipients do not need a Xoxoday account to redeem."
        }
      ]
    }
  ],
  "bundled": true
}